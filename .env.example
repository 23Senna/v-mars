# Copy to `.env` and fill in. `.env` is git-ignored — never commit real credentials.

# PostgreSQL
VMARS_DB_NAME=rotation_platform
VMARS_DB_USER=postgres
VMARS_DB_PASSWORD=change-me
VMARS_DB_HOST=localhost
VMARS_DB_PORT=5432

# Serial ports (use the stable /dev/vmars-* names from deploy/99-vmars-serial.rules if installed)
VMARS_ESP32_PORT=/dev/ttyS2
VMARS_JRT_S1_PORT=/dev/ttyUSB0
VMARS_JRT_S2_PORT=/dev/ttyUSB1
